  function applyLanguage(next) {
    language = next === 'kn' ? 'kn' : 'en';
    document.documentElement.lang = language;
    const picker = $('language'); if (picker) picker.value = language;
    localStorage.setItem('agrisaarthi-language', language);
    Object.entries(selectorMap).forEach(([selector,key]) => {
