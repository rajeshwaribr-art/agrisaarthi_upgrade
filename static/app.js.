/* ---------- Mandi finder ---------- */
(function () {
  'use strict';
  const $ = (id) => document.getElementById(id);
  const form = $('finder-form'), locInput = $('loc'), cropSel = $('crop'), radiusSel = $('radius');
  const msg = $('form-msg'), goBtn = $('go'), geoBtn = $('geo-btn'), resultsBox = $('results');
  if (!form) return;

  const COLORS = ['#168B45', '#D9A52C', '#2B6CB0', '#D9622B', '#7B4BB0', '#1B9AAA'];
  let mode = 'seller';
  let coords = null;            // set by "Use my location"
  let chart = null;
  let suggestTimer = null;
  let requestId = 0;

  const inr = (n) => '₹' + Math.round(n).toLocaleString('en-IN');
  function el(tag, cls, text) {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text !== undefined) e.textContent = text;
    return e;
  }
  function say(text, isError) {
    msg.textContent = text || '';
    msg.className = 'form-msg' + (isError ? ' error' : '');
  }
  async function getJSON(url) {
    const res = await fetch(url, { headers: { Accept: 'application/json' } });
    let data = null;
    try { data = await res.json(); } catch (e) { /* not JSON */ }
    if (!res.ok) throw new Error((data && data.error) || 'Something went wrong (' + res.status + ').');
    return data;
  }

  /* mode toggle (also driven by the BUYER / SELLER buttons in the hero) */
  function setMode(m) {
    mode = m === 'buyer' ? 'buyer' : 'seller';
    document.querySelectorAll('.mode-btn').forEach((b) =>
      b.setAttribute('aria-pressed', String(b.dataset.mode === mode)));
  }
  document.querySelectorAll('.mode-btn').forEach((b) => b.addEventListener('click', () => setMode(b.dataset.mode)));
  document.querySelectorAll('.cta [data-mode]').forEach((a) => a.addEventListener('click', () => {
    setMode(a.dataset.mode);
    setTimeout(() => locInput.focus({ preventScroll: true }), 600);
  }));

  /* crops */
  getJSON('/api/crops').then((d) => {
    cropSel.textContent = '';
    if (!d.crops.length) { cropSel.append(new Option(window.AGRI_T ? window.AGRI_T('chooseCrop') : 'No price data loaded', '')); return; }
    cropSel.append(new Option(window.AGRI_T ? window.AGRI_T('selectCrop') : 'Select a crop', ''));
    d.crops.forEach((c) => cropSel.append(new Option(c, c)));
  }).catch(() => {
    cropSel.textContent = '';
    cropSel.append(new Option(window.AGRI_T ? window.AGRI_T('serverError') : 'Could not load crops', ''));
    say(window.AGRI_T ? window.AGRI_T('serverError') : 'Cannot reach the server. Start it with "python app.py" and open http://127.0.0.1:5000', true);
  });

  /* location suggestions */
  locInput.addEventListener('input', () => {
    coords = null;
    clearTimeout(suggestTimer);
    const q = locInput.value.trim();
    if (q.length < 2) return;
    suggestTimer = setTimeout(() => {
      getJSON('/api/places?q=' + encodeURIComponent(q)).then((d) => {
        const list = $('place-list');
        list.textContent = '';
        d.places.forEach((p) => { const o = document.createElement('option'); o.value = p.name; o.label = p.state || ''; list.append(o); });
      }).catch(() => {});
    }, 200);
  });

  /* geolocation */
  geoBtn.addEventListener('click', () => {
    if (!navigator.geolocation) { say('Your browser cannot share its location. Please type a place instead.', true); return; }
    say('Finding your location…');
    navigator.geolocation.getCurrentPosition((pos) => {
      coords = { lat: pos.coords.latitude, lon: pos.coords.longitude };
      locInput.value = 'My location (' + coords.lat.toFixed(3) + ', ' + coords.lon.toFixed(3) + ')';
      say('Location set. Choose a crop and press Compare.');
    }, (e) => {
      coords = null;
      say(e.code === 1 ? 'Location permission was denied. Please type your town or district instead.'
                       : 'Could not get your location. Please type your town or district instead.', true);
    }, { enableHighAccuracy: false, timeout: 10000, maximumAge: 300000 });
  });

  /* submit */
  form.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const location = locInput.value.trim();
    if (!location) { say('Please enter your location.', true); locInput.focus(); return; }
    if (!cropSel.value) { say('Please choose a crop.', true); cropSel.focus(); return; }
    const params = new URLSearchParams({ crop: cropSel.value, radius: radiusSel.value, mode: mode, limit: '6' });
    if (coords && location.startsWith('My location')) { params.set('lat', coords.lat); params.set('lon', coords.lon); }
    else params.set('location', location);

    const myId = ++requestId;
    goBtn.disabled = true; goBtn.textContent = 'Comparing…'; say('Comparing nearby mandis…');
    try {
      const data = await getJSON('/api/compare?' + params.toString());
      if (myId !== requestId) return;
      render(data);
      say('');
    } catch (e) {
      if (myId !== requestId) return;
      resultsBox.hidden = true;
      say(e.message, true);
    } finally {
      if (myId === requestId) { goBtn.disabled = false; goBtn.textContent = 'Compare mandis'; }
    }
  });

  /* rendering */
  function render(d) {
    const seller = d.mode === 'seller';
    resultsBox.hidden = false;

    const banner = $('banner');
    banner.className = 'banner ' + (d.data_source === 'live' ? 'live' : 'demo');
    banner.textContent = d.data_source === 'live'
      ? (window.AGRI_T ? window.AGRI_T('livePrefix') : 'Live Agmarknet prices, as of ') + d.as_of + '.'
      : (window.AGRI_T ? window.AGRI_T('demoPrefix') : 'DEMO DATA: these prices are simulated for testing and are not real market rates. (As of ') + d.as_of + '.)';

    const b = d.best;
    const best = $('best');
    best.textContent = '';
    best.append(el('small', '', (window.AGRI_T ? window.AGRI_T(seller ? 'bestSell' : 'bestBuy') : (seller ? 'Best mandi to sell at' : 'Best mandi to buy from'))));
    best.append(el('h3', '', b.market + (b.district && b.district !== b.market ? ', ' + b.district : '') + ' (' + b.state + ')'));
    const figs = el('div', 'figs');
    [[b.distance_km + ' km', (window.AGRI_T ? window.AGRI_T('from') : 'from ') + d.location.label],
     [inr(b.expected_price), b.basis === 'forecast' ? (window.AGRI_T ? window.AGRI_T('expected') : 'expected price, next 7 days') : (window.AGRI_T ? window.AGRI_T('latest') : 'latest price')],
     [inr(b.net_price), window.AGRI_T ? window.AGRI_T(seller ? 'afterTransport' : 'includingTransport') : (seller ? 'you receive after transport' : 'you pay including transport')]].forEach((f) => {
      const w = el('div', 'fig'); w.append(el('b', '', f[0]), el('span', '', f[1])); figs.append(w);
    });
    best.append(figs, el('p', '', d.advice));

    $('net-head').textContent = window.AGRI_T ? window.AGRI_T(seller ? 'receive' : 'pay') : (seller ? 'You receive (after transport)' : 'You pay (incl. transport)');
    $('table-cap').textContent = 'Nearby mandis for ' + d.crop + ', ranked';
    const tbody = $('rows');
    tbody.textContent = '';
    d.results.forEach((r) => {
      const tr = el('tr', r.rank === 1 ? 'top' : '');
      tr.append(el('td', 'num', String(r.rank)));

      const tdName = el('td'); tdName.append(document.createTextNode(r.market));
      if (r.source === 'demo') tdName.append(el('span', 'chip', window.AGRI_T ? window.AGRI_T('demoChip') : 'DEMO'));
      tdName.append(el('span', 'sub', [r.district, r.state].filter(Boolean).join(', ')));
      tr.append(tdName);

      const tdDist = el('td', 'num', r.distance_km + ' km');
      tdDist.append(el('span', 'sub', '≈ ' + r.road_km_est + (window.AGRI_T ? window.AGRI_T('road') : ' km by road')));
      tr.append(tdDist);

      const tdNow = el('td', 'num', inr(r.latest_modal));
      tdNow.append(el('span', 'sub', (window.AGRI_T ? window.AGRI_T('on') : 'on ') + r.latest_date));
      tr.append(tdNow);

      const tdFc = el('td', 'num');
      if (r.basis === 'forecast') {
        tdFc.textContent = inr(r.expected_price);
        const ch = (r.expected_price - r.latest_modal) / r.latest_modal * 100;
        const t = el('span', 'sub ' + (ch > 0.5 ? 'up' : ch < -0.5 ? 'down' : ''),
          (ch > 0.05 ? '▲ +' + ch.toFixed(1) : ch < -0.05 ? '▼ ' + Math.abs(ch).toFixed(1) : '0.0') + '% vs today');
        tdFc.append(t);
      } else {
        tdFc.textContent = '—';
        tdFc.append(el('span', 'sub', (window.AGRI_T ? window.AGRI_T('noHistory') : 'not enough history')));
      }
      tr.append(tdFc);

      tr.append(el('td', 'num', inr(r.transport_cost)));
      tr.append(el('td', 'num net', inr(r.net_price)));
      tbody.append(tr);
    });

    drawChart(d);

    $('chart-note').textContent = 'Forecast basis: ' + d.results.map((r) =>
      r.market + ' – ' + (r.method === 'ridge' ? 'AI model (typical 7-day error about ' + r.mape + '%)'
        : r.method === 'persistence' ? 'no reliable trend, shown flat' : (window.AGRI_T ? window.AGRI_T('noHistory') : 'not enough history'))).join('; ') + '.';

    const a = d.assumptions;
    let fine = 'Prices are modal (most common) wholesale prices in ₹ per quintal. Transport is estimated at ₹' +
      a.transport_rs_per_qtl_km + ' per quintal per km on road distance (about ' + a.road_factor + '× the straight-line distance); ' +
      'your real cost depends on load size and vehicle.';
    if (d.expanded_search) fine += ' Fewer than 3 mandis with data were found within ' + d.radius_km + ' km, so the nearest ones are shown instead.';
    if (d.excluded_stale) fine += ' ' + d.excluded_stale + ' mandi(s) were left out because they have not reported recently.';
    $('fine').textContent = fine;

    resultsBox.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function drawChart(d) {
    const note = $('chart-note');
    if (typeof Chart === 'undefined') {
      note.textContent = 'The chart library could not be loaded (check your internet connection).';
      return;
    }
    const dateSet = new Set();
    d.results.forEach((r) => { r.history.forEach((p) => dateSet.add(p.date)); r.forecast.forEach((p) => dateSet.add(p.date)); });
    const labels = Array.from(dateSet).sort();
    const datasets = [];
    d.results.forEach((r, i) => {
      const color = COLORS[i % COLORS.length];
      const hist = new Map(r.history.map((p) => [p.date, p.modal]));
      const fc = new Map(r.forecast.map((p) => [p.date, p.modal]));
      const lastHist = r.history.length ? r.history[r.history.length - 1] : null;
      if (lastHist && fc.size) fc.set(lastHist.date, lastHist.modal);   // join forecast to history
      const base = { borderColor: color, backgroundColor: color, pointRadius: 0, pointHoverRadius: 4,
                     borderWidth: i === 0 ? 3 : 1.75, spanGaps: true, tension: 0.2 };
      datasets.push(Object.assign({ label: r.rank + '. ' + r.market, data: labels.map((l) => hist.has(l) ? hist.get(l) : null) }, base));
      if (fc.size) datasets.push(Object.assign({ label: r.market + ' (forecast)', data: labels.map((l) => fc.has(l) ? fc.get(l) : null),
        borderDash: [6, 5] }, base));
    });
    if (chart) chart.destroy();
    chart = new Chart($('chart'), {
      type: 'line',
      data: { labels: labels, datasets: datasets },
      options: {
        responsive: true, maintainAspectRatio: false, interaction: { mode: 'index', intersect: false },
        scales: {
          x: { ticks: { maxTicksLimit: 8, autoSkip: true }, grid: { display: false } },
          y: { title: { display: true, text: '₹ per quintal' }, ticks: { callback: (v) => '₹' + Number(v).toLocaleString('en-IN') } }
        },
        plugins: {
          legend: { position: 'bottom', labels: { boxWidth: 14, filter: (item) => !/\(forecast\)$/.test(item.text) } },
          tooltip: { callbacks: { label: (c) => c.dataset.label + ': ' + (c.parsed.y == null ? '' : '₹' + Math.round(c.parsed.y).toLocaleString('en-IN')) } }
        }
      }
    });
  }
})();

